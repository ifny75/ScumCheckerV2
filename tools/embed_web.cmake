# Packs every file under WEB_DIR into:
#   OUT_RC  - a resource script embedding each file as RCDATA
#   OUT_CPP - a manifest table (virtual path -> resource id + MIME type)
#   OUT_H   - declarations for the manifest
#
# Invoked via:  cmake -DWEB_DIR=... -DOUT_RC=... -DOUT_CPP=... -DOUT_H=... -P embed_web.cmake

if (NOT WEB_DIR OR NOT OUT_RC OR NOT OUT_CPP OR NOT OUT_H)
    message(FATAL_ERROR "embed_web.cmake requires WEB_DIR, OUT_RC, OUT_CPP, OUT_H")
endif()

file(GLOB_RECURSE _web_files RELATIVE "${WEB_DIR}" "${WEB_DIR}/*")
list(SORT _web_files)

set(_rc "// Generated by tools/embed_web.cmake - do not edit.\n")
set(_cpp "// Generated by tools/embed_web.cmake - do not edit.\n#include \"web_manifest.h\"\n\nconst WebAsset kWebAssets[] = {\n")
set(_id 1000)
set(_count 0)

foreach(_rel IN LISTS _web_files)
    set(_abs "${WEB_DIR}/${_rel}")
    if (IS_DIRECTORY "${_abs}")
        continue()
    endif()

    # MIME type from extension
    get_filename_component(_ext "${_rel}" LAST_EXT)
    string(TOLOWER "${_ext}" _ext)
    if (_ext STREQUAL ".html" OR _ext STREQUAL ".htm")
        set(_mime "text/html; charset=utf-8")
    elseif (_ext STREQUAL ".css")
        set(_mime "text/css; charset=utf-8")
    elseif (_ext STREQUAL ".js" OR _ext STREQUAL ".mjs")
        set(_mime "text/javascript; charset=utf-8")
    elseif (_ext STREQUAL ".json")
        set(_mime "application/json; charset=utf-8")
    elseif (_ext STREQUAL ".svg")
        set(_mime "image/svg+xml")
    elseif (_ext STREQUAL ".png")
        set(_mime "image/png")
    elseif (_ext STREQUAL ".jpg" OR _ext STREQUAL ".jpeg")
        set(_mime "image/jpeg")
    elseif (_ext STREQUAL ".gif")
        set(_mime "image/gif")
    elseif (_ext STREQUAL ".webp")
        set(_mime "image/webp")
    elseif (_ext STREQUAL ".ico")
        set(_mime "image/x-icon")
    elseif (_ext STREQUAL ".woff2")
        set(_mime "font/woff2")
    elseif (_ext STREQUAL ".woff")
        set(_mime "font/woff")
    elseif (_ext STREQUAL ".ttf")
        set(_mime "font/ttf")
    else()
        set(_mime "application/octet-stream")
    endif()

    string(APPEND _rc "${_id} RCDATA \"${_abs}\"\n")
    string(APPEND _cpp "    { L\"${_rel}\", ${_id}, L\"${_mime}\" },\n")

    math(EXPR _id "${_id} + 1")
    math(EXPR _count "${_count} + 1")
endforeach()

string(APPEND _cpp "};\n\nconst int kWebAssetCount = ${_count};\n")

set(_h "// Generated by tools/embed_web.cmake - do not edit.\n")
string(APPEND _h "#pragma once\n\n")
string(APPEND _h "struct WebAsset {\n")
string(APPEND _h "    const wchar_t* path;\n")
string(APPEND _h "    int resourceId;\n")
string(APPEND _h "    const wchar_t* mime;\n")
string(APPEND _h "};\n\n")
string(APPEND _h "extern const WebAsset kWebAssets[];\n")
string(APPEND _h "extern const int kWebAssetCount;\n")

file(WRITE "${OUT_RC}" "${_rc}")
file(WRITE "${OUT_CPP}" "${_cpp}")
file(WRITE "${OUT_H}" "${_h}")

message(STATUS "embed_web: packed ${_count} web asset(s)")
